<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>D2.Wcag</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Walidacja dostępności (WCAG 2.1) i jakości dokumentów Word (DOCX) oraz automatyczna naprawa wybranych problemów. Odczyt i zapis przez DocumentFormat.OpenXml (MIT).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2.Wcag.Tests" />
  </ItemGroup>

</Project>
