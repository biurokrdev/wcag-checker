  "issues": [
    {
      "code": "STY-DIRECT-OVERRIDE",
      "severity": "Error",
      "category": "Text",
      "standard": "style/1.0",
      "message": "Akapit w stylu „Dane rejestrowe” ma formatowanie nadane ręcznie, inne niż w stylu: pogrubienie (tak, w stylu: nie), rozmiar czcionki (9 pt, w stylu: 8 pt).",
      "locations": [
        {
          "key": "body:Paragraph:43",
          "snippet": "Example Company S. A., oddział w Krakowi…"
        }
      ],
      "status": "Required",
      "title": "Formatowanie ręczne inne niż w stylu",
      "fix": "Zaznacz akapit → Ctrl+Spacja (wyczyść formatowanie znaków) → wybierz styl „Dane rejestrowe” z Galerii stylów (Narzędzia główne → Style). Jeśli odstępstwo od stylu jest zamierzone, użyj innego stylu z Galerii (np. znakowego „Pogrubienie”) albo zmień sam styl – nie formatuj ręcznie.",
      "scope": "Paragraph",
      "details": [
        {
          "property": "b",
          "actual": "1",
          "expected": "0",
          "source": "cały tekst akapitu"
        },
        {
